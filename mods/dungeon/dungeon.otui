  VerticalScrollBar
    id: ScrollBar3
    anchors.top: listFrame1.top
    anchors.bottom: listFrame1.bottom
    anchors.left: listFrame1.right
    margin-left: 2
    step: 14
    visible: false
    pixels-scroll: true

  Button
    id: showListButton4
    !text: tr('')
    !icon: 'images/list/nada.png'
    width: 250
    height: 75
    anchors.left: parent.left
    anchors.top: showListButton3.bottom
    margin-top: 30
    margin-left: 10
    borderWidth: 3
    @onClick: modules.food_eater.showListButton4Clicked(4)

  UIScrollArea
    id: listFrame4
    anchors.left: showListButton1.right
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    background-color: #414141
    margin-top: 10
    margin-left: 40
    margin-right: 10
    margin-bottom: 30
    vertical-scrollbar: ScrollBar4
    visible: false
    padding-top: 6
    padding-bottom: 6
    border-width: 2
    border-color: #ffffff
    layout:
