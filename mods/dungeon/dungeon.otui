    margin-right: 10
    margin-bottom: 30
    vertical-scrollbar: ScrollBar3
    visible: false
    padding-top: 6
    padding-bottom: 6
    border-width: 2
    border-color: #ffffff
    layout:
    type: grid
    cell-size: 99 116
    cell-spacing: 100

    Button
      id: boo
      !text: tr('')
      !icon: 'images/nada.png'
      width: 450
      height: 130
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 15
      margin-left: 57
      margin-right: 30

    Button
      id: c18
      !text: tr('')
      !icon: 'images/nada.png'
      width: 450
      height: 130
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 15
      margin-left: 57
      margin-right: 30

    Button
      id: cell
